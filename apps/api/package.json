{
  "name": "@nyx/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed-templates": "tsx src/db/seed-templates.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39",
    "@clerk/backend": "^1",
    "@fastify/cookie": "^11",
    "@fastify/cors": "^11",
    "@fastify/multipart": "^9.4.0",
    "@nyx/shared": "workspace:*",
    "archiver": "^7.0.1",
    "dotenv": "^16",
    "drizzle-orm": "^0.38",
    "fastify": "^5",
    "pdfkit": "^0.16",
    "postgres": "^3",
    "puppeteer": "^24",
    "puppeteer-cluster": "^0.24",
    "stripe": "^20.4.1",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/form-data": "^2.5.2",
    "@types/node": "^22",
    "@types/pdfkit": "^0.13",
    "@vitest/coverage-v8": "^3",
    "drizzle-kit": "^0.30",
    "form-data": "^4.0.5",
    "tsx": "^4",
    "typescript": "^5.7",
    "vitest": "^3"
  }
}
