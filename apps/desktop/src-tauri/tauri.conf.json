{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nyx",
  "identifier": "dev.nyx.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "windows": [{ "label": "main", "title": "Nyx", "width": 1200, "height": 800 }],
    "withGlobalTauri": true,
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "msi", "deb", "rpm", "appimage"],
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "Agent-native workspace with utility-token metering.",
    "icon": ["icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "entitlements": null,
      "signingIdentity": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": { "installMode": "currentUser" }
    },
    "linux": {
      "deb": { "depends": [] }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_TAURI_UPDATER_PUBLIC_KEY_SEE_docs/release/signing-setup.md",
      "endpoints": [
        "https://github.com/NoJuanNobody/nyx/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
