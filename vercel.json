{
  "framework": "vite",
  "buildCommand": "pnpm --filter @syncdocs/shared build && pnpm --filter @syncdocs/web build",
  "outputDirectory": "apps/web/dist",
  "installCommand": "pnpm install",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://api-staging-99ae.up.railway.app/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
