# ── Database ──────────────────────────────────────────────────────────
# Local dev default: postgresql://postgres:postgres@localhost:5432/syncdocs
# Docker Compose: postgresql://postgres:devpassword@localhost:5432/syncdocs_dev
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/syncdocs

# ── Server ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# ── Clerk (auth) ──────────────────────────────────────────────────────
# Get these from your Clerk dashboard → API Keys
# Staging and production use separate Clerk instances (separate publishable/secret keys)
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# Frontend (Vite) — must be prefixed with VITE_ to be exposed to the browser
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# ── Anthropic (AI) ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── GitHub integration ────────────────────────────────────────────────
# GitHub OAuth app credentials (create at github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub webhook secret — required in production
# Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# Public URL where webhooks are delivered (e.g. https://api.staging.syncdocs.io)
# Required when receiving GitHub webhooks
WEBHOOK_BASE_URL=
