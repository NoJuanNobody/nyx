# ── Database ──────────────────────────────────────────────────────────
# Local dev default: postgresql://postgres:postgres@localhost:5432/nyx
# Docker Compose: postgresql://postgres:devpassword@localhost:5432/nyx_dev
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nyx

# ── Server ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Public URL of the frontend app (used in emails, redirects, webhooks)
APP_URL=http://localhost:5173

# ── CORS ──────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for CORS requests
# Defaults to http://localhost:5173 when not set
# Production example: https://nyx-creative.com,https://www.nyx-creative.com
CORS_ORIGINS=http://localhost:5173

# ── Clerk (auth) ──────────────────────────────────────────────────────
# Get these from your Clerk dashboard → API Keys
# https://dashboard.clerk.com → Your app → API Keys
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# Frontend (Vite) — must be prefixed with VITE_ to be exposed to the browser
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Dev auth bypass — set to "true" to skip Clerk auth in development
# NEVER set this in production (server will refuse to start)
# DEV_AUTH_BYPASS=true

# ── Encryption ────────────────────────────────────────────────────────
# Used to encrypt stored OAuth tokens (GitHub, Atlassian, Slack)
# Generate with: openssl rand -hex 32
ENCRYPTION_SECRET=

# Used to encrypt user-provided AI keys (BYOK feature)
# Generate with: openssl rand -hex 32
BYOK_ENCRYPTION_SECRET=

# ── Anthropic (AI) ────────────────────────────────────────────────────
# Powers spec analysis, drift detection, ticket generation, intake, agent
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ── OpenRouter (alternative LLM provider) ────────────────────────────
# Optional. Route LLM calls through OpenRouter instead of Anthropic directly.
# https://openrouter.ai → Keys
OPENROUTER_API_KEY=sk-or-...
# Which provider to use. Set to `openrouter` to route via OpenRouter.
LLM_PROVIDER=anthropic
# Default model id (e.g. anthropic/claude-sonnet-4). Empty = built-in default.
LLM_DEFAULT_MODEL=
# Fast/cheap model id for lightweight calls. Empty = built-in default.
LLM_FAST_MODEL=
# Override the provider base URL. Empty = provider default.
LLM_BASE_URL=

# ── Tavily (web search) ──────────────────────────────────────────────
# Used by the AI agent for web search tool
# https://tavily.com → API Keys (free tier available)
TAVILY_API_KEY=tvly-...

# ── GitHub integration ────────────────────────────────────────────────
# GitHub OAuth app credentials for repo sync
# Create at: https://github.com/settings/developers → OAuth Apps → New
# Callback URL: {APP_URL}/api/integrations/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub webhook secret — required in production
# Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# Public URL where webhooks are delivered (your API URL)
# e.g. https://nyx-staging.up.railway.app
WEBHOOK_BASE_URL=

# GitHub classic PAT for submitting user feedback as issues
# Needs `repo` scope. Create at: https://github.com/settings/tokens/new
GITHUB_FEEDBACK_PAT=ghp_...

# ── GitLab integration ────────────────────────────────────────────────
# GitLab OAuth app credentials
# Create at: https://gitlab.com/-/user_settings/applications
# Callback URL: {APP_URL}/api/integrations/gitlab/callback
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
# For self-hosted GitLab, set the base URL (e.g. https://gitlab.mycompany.com)
# Leave empty for GitLab.com (cloud)
GITLAB_BASE_URL=

# ── Bitbucket integration ────────────────────────────────────────────
# Bitbucket OAuth consumer credentials
# Create at: Bitbucket workspace settings → OAuth consumers
# Callback URL: {APP_URL}/api/integrations/bitbucket/callback
BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=

# ── Atlassian (Jira & Confluence) ─────────────────────────────────────
# OAuth 2.0 (3LO) app for Jira ticket creation and Confluence sync
# Create at: https://developer.atlassian.com/console/myapps/
# Callback URL: {APP_URL}/api/integrations/atlassian/callback
# Required scopes: read:jira-work, write:jira-work, read:confluence-content.all
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# Jira webhook secret for verifying incoming webhook payloads
# Generate with: openssl rand -hex 32
JIRA_WEBHOOK_SECRET=

# ── Slack integration ────────────────────────────────────────────────
# Slack app for notifications and slash commands
# Create at: https://api.slack.com/apps → Create New App
# Redirect URL: {APP_URL}/api/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# ── Email (Resend) ───────────────────────────────────────────────────
# Transactional emails (invitations, notifications, digests)
# https://resend.com/api-keys
RESEND_API_KEY=re_...

# Sender address — domain must be verified in Resend
EMAIL_FROM=Nyx <nyx@nyx-creative.com>

# ── OpenAI (TTS) ─────────────────────────────────────────────────────
# Text-to-speech for podcast audio generation
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── Google AI ─────────────────────────────────────────────────────────
# Alternative AI provider for BYOK (Bring Your Own Key)
# https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=

# ── Recall.ai (voice agent) ──────────────────────────────────────────
# Voice agent for joining Zoom/Meet/Teams calls
# https://www.recall.ai → Dashboard → API Keys
# Without this, voice agent runs in stub/dev mode
RECALL_AI_API_KEY=
RECALL_AI_WEBHOOK_SECRET=

# ── Sentry (error monitoring) ────────────────────────────────────────
# DSN from your Sentry project settings
# https://docs.sentry.io/product/sentry-basics/concepts/dsn-explainer/
SENTRY_DSN=

# ── Admin ─────────────────────────────────────────────────────────────
# Comma-separated emails that can see all documents across all teams
# SUPER_ADMIN_EMAILS=admin@example.com,other@example.com

# ── Recall.ai (voice agent) ─────────────────────────────────────────
# API key from your Recall.ai dashboard
# Required for real Zoom/Google Meet/Teams call integration
# Without this, the voice agent runs in stub/dev mode
RECALL_AI_API_KEY=
# Webhook secret for verifying Recall.ai webhook payloads (optional but recommended)
RECALL_AI_WEBHOOK_SECRET=
